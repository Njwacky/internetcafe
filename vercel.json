{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "mkdir -p _vercel_static && cp owner-dashboard.html _vercel_static/index.html && cp owner-dashboard.html _vercel_static/owner-dashboard.html && cp cafe-desk-manual.html _vercel_static/cafe-desk-manual.html",
  "outputDirectory": "_vercel_static",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/admin", "destination": "/owner-dashboard.html" },
    { "source": "/dashboard", "destination": "/owner-dashboard.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
